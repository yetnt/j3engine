<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.j3d</groupId>
    <artifactId>J3Engine</artifactId>
    <version>1.1.0</version>

    <dependencies>
        <dependency>
            <groupId>com.jaiva</groupId>
            <artifactId>jaiva</artifactId>
            <version>5.0.2</version>
        </dependency>
    </dependencies>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>

<!--        <pluginManagement>-->
<!--            <plugins>-->
<!--                <plugin>-->
<!--                    <groupId>org.panteleyev</groupId>-->
<!--                    <artifactId>jpackage-maven-plugin</artifactId>-->
<!--                    <version>1.6.0</version>-->
<!--                    <configuration>-->
<!--                        &lt;!&ndash; Empty config to make IDE happy &ndash;&gt;-->
<!--                    </configuration>-->
<!--                </plugin>-->
<!--            </plugins>-->
<!--        </pluginManagement>-->

        <plugins>
            <!-- Create the fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.j3d.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <name>J3Engine</name>
                            <appVersion>${project.version}</appVersion>
                            <icon>src/main/resources/art/logo/J3Dicon.ico</icon>
                            <description>J3Engine Project</description>
                            <vendor>yetnt</vendor>
                            <mainClass>com.j3d.Main</mainClass>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <!--                        <runtimeImage>${java.home}</runtimeImage>-->

                            <resourceDir>src/main/resources</resourceDir>
                            <type>MSI</type>


                            <input>${project.build.directory}</input>
                            <destination>${project.build.directory}/jpackage</destination>

                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>

                            <!-- File associations -->
                            <fileAssociations>
                                <fileAssociation>src/main/resources/file-assoc-j3d.properties</fileAssociation>
                            </fileAssociations>

                            <winPerUserInstall>false</winPerUserInstall>
                            <aboutUrl>https://github.com/yetnt/j3engine</aboutUrl>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-icon</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/art/logo</directory>
                                    <includes>
                                        <include>J3Dicon.ico</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>