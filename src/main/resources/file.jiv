@ jaiva script to just query the engine

tsea "jaiva/debug"!
tsea "jaiva/arrays"!
tsea "jaiva/j3d"!
tsea "jaiva/math"!

maak ls <- a_filter(layers(), f~(layer) : get_layer_name(layer) != "BACKG")!
maak layer <- ls[1]!
khuluma(get_layer_name(layer))!
maak stuff <- get_layer_things(layer)!
khuluma(stuff)!
maak first <- stuff[0]!
khuluma(first)!
maak id <- get_thing_id(first)!
khuluma(id)!
khuluma(get_thing_centre(first))!

maak rot <- v3_rot(get_thing_centre(first), arrLit(0, 1, 0), 90)!
khuluma(rot)!
khuluma(v3_zeroClamp(rot))!

khuluma(v3_cross(arrLit(1, 1, 2), arrLit(9, 3, 1)))!

khuluma(v3_dot(arrLit(1, 1, 2), arrLit(9, 3, 1)))!

maak points <-|!
colonize (i <- 0 <| i < 360*5 <| i + 45) ->
    maak new <- new_point(arrLit(i, m_sin(m_toRad(i))*40, 0), id)!
    points <- arrLit(points:::)!
        |> get_uuid_value(get_point_id(new))!
<~

join(points, id)!

@ circle.
maak r <- 10!

colonize (z <- 0 <| z < 360 <| +) ->
    maak x <- r * m_cos(m_toRad(z))!
    maak y <- r * m_sin(m_toRad(z))!

    new_point(arrLit(x, y, 0), id, arrLit(0, 255, 0))!
<~