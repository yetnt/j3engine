@ jaiva script to just query the engine

tsea "jaiva/debug"!
tsea "jaiva/j3d"!
tsea "jaiva/j3d/objects"!
tsea "jaiva/j3d/objects/getters"!

maak triangle <- getCallerValue()! @ random GObject from command palette input
@ if its not a triangle the next call will error

if (triangle~ = 0) ->
    cima <== "No input given"!
<~

maak pivot <- get_tri_pivot(triangle)!

maak colour <- get_tri_colour( triangle)!

maak lineA <- get_tri_lineA(triangle)!

maak windingPointB <- get_tri_windingB(triangle)!

maak uuid <- get_tri_id( triangle )!

khuluma( "Triangle properties" )!
khuluma( triangle )!
khuluma( "Triangle pivot" )!
khuluma( pivot )!
khuluma( "Triangle pivot (Sum of the properties multiplied by 10)" )!
khuluma( get_vector3_asFunc(pivot)(f~(x,y,z) : (x+y+z))*10 )!
khuluma( "Colour of tri" )!
khuluma( colour )!
khuluma( "Line A" )!
khuluma( lineA )!
khuluma( "winding point b")!
khuluma( windingPointB )!
khuluma( "Triangle uuid" )!
khuluma( uuid )!
khuluma( get_uuid_value(uuid) )!